# コピーして .env を作る（.env は Git 管理外）
POSTGRES_USER=thinkronos
POSTGRES_PASSWORD=change-me
POSTGRES_DB=thinkronos
# Windows 側の予約ポートと被る場合は変える
POSTGRES_PORT=5432
REDIS_PORT=6379
# PC に Ollama を直接入れていると 11434 が使われているため、既定は 11435
OLLAMA_PORT=11435
API_PORT=8000

# 監視（Grafana は匿名で Admin になる。127.0.0.1 にだけ公開される）
GRAFANA_PORT=3000
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
